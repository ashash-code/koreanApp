<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/achievementCard"
    android:layout_width="match_parent"
    android:layout_height="520dp"
    android:layout_margin="16dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="40dp"
    app:cardElevation="32dp"
    app:cardBackgroundColor="@android:color/white"
    app:strokeWidth="1.5dp"
    app:strokeColor="#F0F0F0">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/grey_dark" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Achievement Unlocked!"
            android:textColor="@color/blue_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivClose" />

        <View
            android:id="@+id/achievementGlow"
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:background="@drawable/glow_effect"
            app:layout_constraintBottom_toBottomOf="@id/ivYeyImage"
            app:layout_constraintEnd_toEndOf="@id/ivYeyImage"
            app:layout_constraintStart_toStartOf="@id/ivYeyImage"
            app:layout_constraintTop_toTopOf="@id/ivYeyImage" />

        <ImageView
            android:id="@+id/ivYeyImage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="8dp"
            android:src="@drawable/yey"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toTopOf="@+id/badgeContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <LinearLayout
            android:id="@+id/badgeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded_top_corners"
            android:backgroundTint="#F2F7FF"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/ivBadgeIcon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_colors"
                app:tint="@color/korean_blue" />

            <TextView
                android:id="@+id/tvAchievementName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Artist"
                android:textColor="@color/black"
                android:textSize="32sp"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>