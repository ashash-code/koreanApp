<?xml version="1.0" encoding="utf-8"?>
    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    tools:context=".profilePage">

    <!-- Header Section Inspired by the provided UI -->
    <View
        android:id="@+id/headerBackground"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:background="@color/blue_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:padding="12dp"
        android:src="@drawable/ic_back"
        android:contentDescription="@string/back_button_desc"
        app:layout_constraintBottom_toBottomOf="@id/headerBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/headerBackground"
        app:tint="@android:color/white" />

    <TextView
        android:id="@+id/tvLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/logo_text"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/headerBackground"
        app:layout_constraintStart_toEndOf="@id/ivBack"
        app:layout_constraintTop_toTopOf="@id/headerBackground" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/profile_title"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@id/tvLogo"
        app:layout_constraintStart_toEndOf="@id/tvLogo"
        app:layout_constraintTop_toTopOf="@id/tvLogo" />



    <!-- Profile Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivProfilePicture"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:layout_marginTop="32dp"
                android:contentDescription="Profile Picture"
                android:scaleType="centerCrop"
                android:src="@android:drawable/sym_def_app_icon"
                app:shapeAppearanceOverlay="@style/CircleImage" />

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:text="@string/user_name"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <TextView
                android:id="@+id/tvUserEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/user_email"
                android:textSize="16sp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp">

                <TextView
                    android:id="@+id/tvProgressLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/overall_progress"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:id="@+id/tvProgressPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/progress_percentage"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/blue_primary" />

            </RelativeLayout>

            <ProgressBar
                android:id="@+id/pbOverallProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:progress="0"
                android:progressTint="@color/blue_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/achievements_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:columnCount="3"
                    android:alignmentMode="alignMargins"
                    android:rowOrderPreserved="false">

                    <!-- Learner -->
                    <LinearLayout
                        android:id="@+id/badgeLearnerLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:alpha="0.3"
                        android:padding="8dp">
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_learn"
                            android:contentDescription="@string/badge_learner"
                            app:tint="@color/korean_blue" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/badge_learner"
                            android:textSize="11sp"
                            android:textAlignment="center" />
                    </LinearLayout>

                    <!-- Quizzer -->
                    <LinearLayout
                        android:id="@+id/badgeQuizzerLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:alpha="0.3"
                        android:padding="8dp">
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_quiz"
                            android:contentDescription="@string/badge_quizzer"
                            app:tint="@color/korean_blue" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/badge_quizzer"
                            android:textSize="11sp"
                            android:textAlignment="center" />
                    </LinearLayout>

                    <!-- Polyglot -->
                    <LinearLayout
                        android:id="@+id/badgePolyglotLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:alpha="0.3"
                        android:padding="8dp">
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_translate"
                            android:contentDescription="@string/badge_polyglot"
                            app:tint="@color/korean_blue" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/badge_polyglot"
                            android:textSize="11sp"
                            android:textAlignment="center" />
                    </LinearLayout>

                    <!-- Hangul -->
                    <LinearLayout
                        android:id="@+id/badgeAlphabetLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:alpha="0.3"
                        android:padding="8dp">
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_alphabet"
                            android:contentDescription="@string/badge_alphabet"
                            app:tint="@color/korean_blue" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/badge_alphabet"
                            android:textSize="11sp"
                            android:textAlignment="center" />
                    </LinearLayout>

                    <!-- Numbers -->
                    <LinearLayout
                        android:id="@+id/badgeNumbersLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:alpha="0.3"
                        android:padding="8dp">
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_numbers"
                            android:contentDescription="@string/badge_numbers"
                            app:tint="@color/korean_blue" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/badge_numbers"
                            android:textSize="11sp"
                            android:textAlignment="center" />
                    </LinearLayout>

                    <!-- Greetings -->
                    <LinearLayout
                        android:id="@+id/badgeGreetingsLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:alpha="0.3"
                        android:padding="8dp">
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_greetings"
                            android:contentDescription="@string/badge_greetings"
                            app:tint="@color/korean_blue" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/badge_greetings"
                            android:textSize="11sp"
                            android:textAlignment="center" />
                    </LinearLayout>

                    <!-- Food -->
                    <LinearLayout
                        android:id="@+id/badgeFoodLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:alpha="0.3"
                        android:padding="8dp">
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_food"
                            android:contentDescription="@string/badge_food"
                            app:tint="@color/korean_blue" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/badge_food"
                            android:textSize="11sp"
                            android:textAlignment="center" />
                    </LinearLayout>

                    <!-- Places -->
                    <LinearLayout
                        android:id="@+id/badgePlacesLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:alpha="0.3"
                        android:padding="8dp">
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_places"
                            android:contentDescription="@string/badge_places"
                            app:tint="@color/korean_blue" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/badge_places"
                            android:textSize="11sp"
                            android:textAlignment="center" />
                    </LinearLayout>

                    <!-- Colors -->
                    <LinearLayout
                        android:id="@+id/badgeColorsLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:alpha="0.3"
                        android:padding="8dp">
                        <ImageView
                            android:id="@+id/ivBadgeColors"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_colors"
                            android:contentDescription="@string/badge_colors"
                            app:tint="@color/korean_blue" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/badge_colors"
                            android:textSize="11sp"
                            android:textAlignment="center" />
                    </LinearLayout>

                    <!-- Family -->
                    <LinearLayout
                        android:id="@+id/badgeFamilyLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:alpha="0.3"
                        android:padding="8dp">
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_family"
                            android:contentDescription="@string/badge_family"
                            app:tint="@color/korean_blue" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/badge_family"
                            android:textSize="11sp"
                            android:textAlignment="center" />
                    </LinearLayout>

                    <!-- Verbs -->
                    <LinearLayout
                        android:id="@+id/badgeVerbsLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:alpha="0.3"
                        android:padding="8dp">
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_verbs"
                            android:contentDescription="@string/badge_verbs"
                            app:tint="@color/korean_blue" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/badge_verbs"
                            android:textSize="11sp"
                            android:textAlignment="center" />
                    </LinearLayout>

                    <!-- Time -->
                    <LinearLayout
                        android:id="@+id/badgeTimeLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:alpha="0.3"
                        android:padding="8dp">
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_time"
                            android:contentDescription="@string/badge_time"
                            app:tint="@color/korean_blue" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/badge_time"
                            android:textSize="11sp"
                            android:textAlignment="center" />
                    </LinearLayout>

                </GridLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>